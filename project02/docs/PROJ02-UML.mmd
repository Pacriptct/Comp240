        +totalCollectedFare() double
        +findTripsByPassId(String passId) ArrayList~TripRecord~
        +getPasses() ArrayList~TransitPass~
        +getTrips() ArrayList~TripRecord~
    }
    class TransitFareApp {
        -Scanner INPUT$
        -FareManager MANAGER$
        +main(String[] args) void
